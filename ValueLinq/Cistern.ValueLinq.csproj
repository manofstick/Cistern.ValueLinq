<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Cistern.ValueLinq</RootNamespace>
    <AssemblyName>Cistern.ValueLinq</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>1.0.0-preview.1</Version>
    <Authors>Paul Westcott</Authors>
    <Description>LINQ to Objects rebuilt from value types, no need to change any code, except changing one using statement.</Description>
    <PackageProjectUrl>https://github.com/manofstick/Cistern.ValueLinq</PackageProjectUrl>
    <RepositoryUrl>https://github.com/manofstick/Cistern.ValueLinq</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Diagnostics.CodeAnalysis" />
  </ItemGroup>

  <!-- the generators that write each operator's boilerplate (see Operator.cs); their output is not checked in -->
  <ItemGroup>
    <ProjectReference Include="..\Cistern.ValueLinq.Generators\Cistern.ValueLinq.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\SR.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SR.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\SR.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>SR.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <TextTemplate Include="EnumerableWrappers\Aggregates.tt;EnumerableWrappers\Binary.tt;EnumerableWrappers\Maths.tt;EnumerableWrappers\Transforms.tt;ValueEnumerable\ExtensionFunctions.tt" />
    <TextTemplateInclude Include="EnumerableWrappers\Collections.tth" />
    <Compile Include="@(TextTemplate->'$(BaseIntermediateOutputPath)t4/%(Filename).cs')" />
  </ItemGroup>

  <Target Name="TransformTextTemplates"
          BeforeTargets="CoreCompile"
          Inputs="@(TextTemplate);@(TextTemplateInclude)"
          Outputs="@(TextTemplate->'$(BaseIntermediateOutputPath)t4/%(Filename).cs')">
    <Exec Command="dotnet tool restore" EnvironmentVariables="DOTNET_ROOT=" StandardOutputImportance="low" />
    <MakeDir Directories="$(BaseIntermediateOutputPath)t4" />
    <!-- dotnet-t4 finds its SDK through DOTNET_ROOT but launches that SDK's compiler with the default install's dotnet -->
    <Exec Command="dotnet t4 &quot;%(TextTemplate.FullPath)&quot; -o &quot;$(BaseIntermediateOutputPath)t4/%(TextTemplate.Filename).cs&quot;" EnvironmentVariables="DOTNET_ROOT=" />
  </Target>

</Project>
