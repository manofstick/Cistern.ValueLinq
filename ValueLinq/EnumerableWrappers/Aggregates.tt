using Cistern.ValueLinq.Aggregation;
using Cistern.ValueLinq.Containers;
using System;
using System.Collections.Generic;

namespace Cistern.ValueLinq
{
<#
    foreach(var collection in collections)
    {
        var genericCollectionType = collection.CollectionType("TSource");

        // the source is checked before the aggregator, whose constructor checks the other arguments, is built
        var source = collection.IsNullable ? "source ?? throw new ArgumentNullException(nameof(source))" : "source";

        // a count known without enumerating sizes a dictionary, as System.Linq sizes one; read once source is checked
        var capacity =
            collection.StaticClassName == "Enumerable"
                ? "source.TryGetNonEnumeratedCount(out var count) ? count : 0"
                : collection.StaticClassName == "ValueLinqList"
                    ? "source.Count"
                    : "source.Length";
#>
    public static partial class <#= collection.StaticClassName #>
    {
<#
        foreach(var aggregate in aggregateTypes)
        {
            var signature = $"public static {aggregate.FunctionReturns} {aggregate.Signature(genericCollectionType)}";
            if (handWritten.Contains(signature))
                continue;

            var args = aggregate.Args.Replace("{capacity}", capacity);

            if (collection.OptimizedCall != null)
            {
#>
        <#= signature #>
        {
            var aggregate = new <#= aggregate.Class #>(<#= args #>);
            <#= collection.OptimizedCall #>(source, ref aggregate);
            return <#= aggregate.WrapReturn("aggregate.GetResult()") #>;
        }

<#
            }
            else
            {
#>
        <#= signature #> =>
            <#= aggregate.WrapReturn($"{collection.FastEnumerate}<TSource, {aggregate.AggregateReturns}, {aggregate.Class}>({source}, new {aggregate.Class}({args}))") #>;

<#
            }
        }

        foreach(var aggregate in elementAggregateTypes)
        {
#>
        public static <#= aggregate.Returns #> <#= aggregate.Signature(collection.CollectionType(aggregate.Element)) #> =>
            <#= collection.FastEnumerate #><<#= aggregate.Element #>, <#= aggregate.Returns #>, <#= aggregate.Class #>>(<#= source #>, new <#= aggregate.Class #>(<#= aggregate.Args.Replace("{capacity}", capacity) #>));

<#
        }
#>
    }
<#
    }
#>
}




